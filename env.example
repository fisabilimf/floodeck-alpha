# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
FLASK_ENV=development

# Database Configuration
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your-database-password
MYSQL_DB=floodeck_alpha
MYSQL_PORT=3306

# SQLAlchemy Configuration
SQLALCHEMY_TRACK_MODIFICATIONS=False
SQLALCHEMY_ENGINE_OPTIONS_POOL_SIZE=10
SQLALCHEMY_ENGINE_OPTIONS_POOL_RECYCLE=3600
SQLALCHEMY_ENGINE_OPTIONS_POOL_PRE_PING=True

# Pagination
ITEMS_PER_PAGE=10

# Cache Configuration
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# WhatsApp API Configuration
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_API_URL=https://api.whatsapp.com/v1

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=floodeck.log

# Performance Configuration
MAX_PER_PAGE=100
CACHE_TIMEOUT_SENSOR=60
CACHE_TIMEOUT_WATER=60
CACHE_TIMEOUT_FORECASTING=60 